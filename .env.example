# Use a long random hexadecimal password (URL-safe).
POSTGRES_PASSWORD=replace-with-a-long-random-hex-password
HTTP_BIND=127.0.0.1
SITE_ADDRESS=http://localhost
SMTP_BIND=127.0.0.1

# Outbound delivery is opt-in. Set a 64-character random hex key before enabling workers.
WORKER_COUNT=0
RELAYTALE_MASTER_KEY=

# Automatic cleanup is disabled by default. 0 retention days disables that category.
MAINTENANCE_INTERVAL=0s
EML_RETENTION_DAYS=180
DEBUG_RETENTION_DAYS=30
CLEANUP_BATCH=100

# Keep disabled until real Provider validation passes.
RETRY_ENABLED=false

FAILOVER_ENABLED=false

HEALTH_ENABLED=false

# Fresh deployments use RelayTale names. Existing installations: see docs/rename-relaytale.md.
COMPOSE_PROJECT_NAME=relaytale
POSTGRES_USER=relaytale
POSTGRES_DB=relaytale

# Admission budgets; working-set reservations are not an RSS limit.
MEMORY_BUDGET_BYTES=67108864
SPOOL_BUDGET_BYTES=268435456

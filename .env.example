# Use a long random hexadecimal password (URL-safe).
POSTGRES_PASSWORD=replace-with-a-long-random-hex-password
HTTP_BIND=127.0.0.1
SITE_ADDRESS=http://localhost
SMTP_BIND=127.0.0.1

# Outbound delivery is opt-in. Set a 64-character random hex key before enabling workers.
WORKER_COUNT=0
MAILGATEWAY_MASTER_KEY=
